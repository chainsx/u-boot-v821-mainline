bootm_size=0x4000000
bootdelay=1
boot_targets=mmc0
fit_addr_r=0x82000000
kernel_addr_r=0x80400000
kernel_comp_addr_r=0x82c00000
kernel_comp_size=0x400000
fdt_addr_r=0x80f80000
fdtoverlay_addr_r=0x80f00000
scriptaddr=0x80ec0000
pxefile_addr_r=0x80e80000
ramdisk_addr_r=0x81800000
bootcmd=if test ${boot_source} = spi; then run spi_boot; else run mmc_boot; fi
mmc_boot=bootflow scan -bG
spi_boot=sf probe; sf read ${fit_addr_r} 0x600000 0xa00000; setenv bootargs console=ttyS0,115200 root=/dev/ram0 rw init=/sbin/init; bootm ${fit_addr_r}
