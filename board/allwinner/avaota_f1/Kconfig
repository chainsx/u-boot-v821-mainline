	select RISCV_ANDES
	select DM_GPIO
	select SUNXI_GPIO
	select SUNXI_NEW_PINCTRL
	select SUPPORT_SPL
	select SPL_IMAGE_TYPE_SUNXI_EGON
	select MMC_SUNXI_HAS_NEW_MODE
	select CLK_SUN300I_V821
	select PINCTRL_SUN300I_V821
	select SPL_DM_GPIO
	select SPL_GPIO

